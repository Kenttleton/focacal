# focacal environment configuration
# Copy this to .env and fill in your values.
# This file is read by Docker Compose automatically.
# NEVER commit .env to version control.

# ── OAuth credentials ─────────────────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application type).
# Add http://localhost:8080/oauth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Register an app, add http://localhost:8080/oauth/callback/outlook as redirect URI.
# Grant Calendars.Read (and Calendars.ReadWrite if writeback is enabled).
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# ── OAuth callback ────────────────────────────────────────────────────────────
# For local use, leave as localhost.
# For a deployed instance, set to your public domain:
#   OAUTH_REDIRECT_BASE_URL=https://focacal.yourdomain.com
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# ── Ollama ────────────────────────────────────────────────────────────────────
# If Ollama runs on the host (not in Docker): http://host.docker.internal:11434
# If Ollama is in the same Compose stack:    http://ollama:11434
# If Ollama is on another machine:           http://192.168.1.x:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model to use. qwen2.5:14b is recommended for tool-use reliability.
# Lighter option for lower-end hardware: qwen2.5:7b
OLLAMA_MODEL=qwen2.5:14b

# ── Port overrides (optional) ─────────────────────────────────────────────────
# Uncomment to change the published ports on the host.
# CALDAV_PORT=5232
# REST_PORT=5233
# MCP_PORT=5234
# OAUTH_PORT=8080
# OLLAMA_PORT=11434   # only used with docker-compose.ollama.yml

# ── Debug ─────────────────────────────────────────────────────────────────────
# ── ICS feed URLs (secrets) ──────────────────────────────────────────────────
# ICS_URL_EXAMPLE=https://calendar.example.com/feed.ics?token=SECRET
# Feed URLs are secrets; keep them in .env or credential files, never in calendars.yaml in plaintext if possible.

FOCACAL_DEBUG=false
