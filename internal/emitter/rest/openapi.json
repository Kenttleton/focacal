{
  "openapi": "3.1.0",
  "info": {
    "title": "Focacal",
    "version": "1.0.0",
    "description": "AI-powered calendar focus scheduler. Read your calendar, query focus blocks, trigger replanning, and manage your schedule."
  },
  "servers": [
    { "url": "http://localhost:5233", "description": "Local instance" }
  ],
  "paths": {
    "/today": {
      "get": {
        "operationId": "getToday",
        "summary": "Get today's full agenda",
        "description": "Returns all real calendar events and AI-planned blocks for today sorted by start time.",
        "parameters": [
          {
            "name": "tz",
            "in": "query",
            "description": "IANA timezone name (e.g. America/New_York). Defaults to UTC.",
            "schema": { "type": "string", "example": "America/New_York" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of events and blocks for today",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } }
              }
            }
          }
        }
      }
    },
    "/now": {
      "get": {
        "operationId": "getNow",
        "summary": "Get the current or next event",
        "description": "Returns the event or block that is active right now. If nothing is active, returns the next upcoming item. Returns null if the day is empty.",
        "parameters": [
          {
            "name": "tz",
            "in": "query",
            "description": "IANA timezone name. Defaults to UTC.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Current or next event, or null",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/Event" },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "List real calendar events",
        "description": "Returns synced calendar events (not AI blocks) for a date range.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "Range start in RFC 3339. Defaults to start of today.",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Range end in RFC 3339. Defaults to 14 days from now.",
            "schema": { "type": "string", "format": "date-time" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of calendar events",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } }
              }
            }
          }
        }
      }
    },
    "/blocks": {
      "get": {
        "operationId": "listBlocks",
        "summary": "List AI-planned focus blocks",
        "description": "Returns focus, lunch, and break blocks planned by the AI for a date range.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "Range start in RFC 3339. Defaults to start of today.",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Range end in RFC 3339. Defaults to 14 days from now.",
            "schema": { "type": "string", "format": "date-time" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of planned blocks",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createBlock",
        "summary": "Create a locked focus block",
        "description": "Creates a user-defined block. Always locked — the AI will not move or delete it on the next replan.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateBlockRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created block",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Event" }
              }
            }
          }
        }
      }
    },
    "/blocks/{id}": {
      "patch": {
        "operationId": "updateBlock",
        "summary": "Update a block",
        "description": "Update a block's end time, title, or locked status.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Block ID (as returned in the id field, e.g. focacal-block-{uuid})"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateBlockRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated block",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Event" }
              }
            }
          },
          "404": { "description": "Block not found" }
        }
      },
      "delete": {
        "operationId": "deleteBlock",
        "summary": "Delete a block",
        "description": "Permanently removes a block. Locked blocks can be deleted here (this endpoint always succeeds regardless of lock status).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "description": "Block not found" }
        }
      }
    },
    "/replan": {
      "post": {
        "operationId": "triggerReplan",
        "summary": "Trigger an AI replan",
        "description": "Asks the AI agent to regenerate the focus schedule for the next 7 days based on current calendar events.",
        "responses": {
          "202": {
            "description": "Replan accepted and running asynchronously",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "replan triggered" } }
                }
              }
            }
          }
        }
      }
    },
    "/config/{domain}": {
      "parameters": [
        {
          "name": "domain",
          "in": "path",
          "required": true,
          "description": "Config domain. app: server, agent, oauth, auth.enabled (config.yaml). planner: working_hours, lunch, focus, colors (planner.yaml). calendars: sources, destinations (calendars.yaml).",
          "schema": { "type": "string", "enum": ["app", "planner", "calendars"] }
        }
      ],
      "get": {
        "operationId": "getConfigDomain",
        "summary": "Get one config domain",
        "description": "Returns the saved values of one domain (file contents over defaults; environment overrides are not applied). Secrets (password, ics_url, api_key) are never returned; each source carries has_secret instead.",
        "responses": {
          "200": {
            "description": "The domain's saved values",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConfigView" } } }
          },
          "404": { "description": "Unknown config domain", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "500": { "description": "A config file on disk could not be read, parsed or written; details are in the server log", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "patch": {
        "operationId": "patchConfigDomain",
        "summary": "Update one config domain",
        "description": "Applies an RFC 7396 JSON merge patch to the domain's file. Send only what changes; null deletes a key or a collection item. Collections (sources, destinations) are objects keyed by item id (destinations: id|calendar_id). The patched domain is validated before anything is written; on any error the file is unchanged. Comments in the file are preserved. Changes take effect after a restart (see pending_restart). Secrets cannot be set through the API; reference them with *_env or *_file fields. The body is limited to 1 MiB.",
        "requestBody": {
          "required": true,
          "content": {
            "application/merge-patch+json": {
              "schema": { "type": "object", "additionalProperties": true },
              "example": { "working_hours": { "start": "08:30" } }
            },
            "application/json": {
              "schema": { "type": "object", "additionalProperties": true },
              "example": { "sources": { "work": { "label": "Work" }, "old-feed": null } }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved; the domain's new values",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConfigView" } } }
          },
          "400": { "description": "Malformed body: not JSON, not a JSON object, an unknown key, or a value of the wrong type", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Unknown config domain", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "413": { "description": "Body larger than 1 MiB", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "422": { "description": "Validation failed (a bad value, a required value set to null, or an inline secret); nothing was written", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "500": { "description": "A config file on disk could not be read, parsed or written; details are in the server log", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service health and sync status",
        "description": "Returns service status, last successful replan time, and per-source sync and webhook state.",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/calendar.ics": {
      "get": {
        "operationId": "getCalendarFeed",
        "summary": "Webcal ICS feed",
        "description": "Returns the next 14 days of events and AI blocks as a standard iCalendar (ICS) file. Subscribe in any calendar app with webcal://host:5233/calendar.ics",
        "responses": {
          "200": {
            "description": "iCalendar feed",
            "content": { "text/calendar": { "schema": { "type": "string" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "type": "object",
        "properties": {
          "id":             { "type": "string", "description": "Composite ID. Blocks use prefix focacal-block-{uuid}" },
          "type":          { "type": "string", "enum": ["real", "focus", "lunch", "break"] },
          "source":        { "type": "string", "description": "Source calendar ID, or 'focacal' for AI blocks" },
          "title":         { "type": "string" },
          "start":         { "type": "string", "format": "date-time" },
          "end":           { "type": "string", "format": "date-time" },
          "all_day":       { "type": "boolean" },
          "conference_url":{ "type": "string", "description": "Zoom / Meet / Teams URL if present" },
          "locked":        { "type": "boolean", "description": "Locked blocks are skipped by the AI on replan" },
          "is_now":        { "type": "boolean", "description": "True if this event is currently active" },
          "minutes_until": { "type": "integer", "description": "Minutes until start. Negative means already started." }
        },
        "required": ["id", "type", "source", "title", "start", "end", "is_now", "minutes_until"]
      },
      "CreateBlockRequest": {
        "type": "object",
        "required": ["start", "end"],
        "properties": {
          "type":     { "type": "string", "enum": ["focus", "lunch", "break"], "default": "focus" },
          "title":    { "type": "string", "default": "Focus block" },
          "start":    { "type": "string", "format": "date-time" },
          "end":      { "type": "string", "format": "date-time" },
          "priority": { "type": "integer", "default": 0 }
        }
      },
      "UpdateBlockRequest": {
        "type": "object",
        "properties": {
          "end":    { "type": "string", "format": "date-time", "description": "New end time" },
          "title":  { "type": "string" },
          "locked": { "type": "boolean" }
        }
      },
      "ConfigView": {
        "type": "object",
        "required": ["values", "order", "pending_restart"],
        "properties": {
          "values": {
            "type": "object",
            "additionalProperties": true,
            "description": "Saved values keyed by top-level key (e.g. working_hours, focus). Collections are objects keyed by item id; secrets are omitted and each source carries has_secret.",
            "example": { "working_hours": { "start": "09:00", "end": "17:00", "timezone": "America/New_York" } }
          },
          "order": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "type": "string" } },
            "description": "Each collection's ids in file order, since JSON objects are unordered. Empty for domains without collections.",
            "example": { "sources": ["work", "feed"] }
          },
          "pending_restart": {
            "type": "boolean",
            "description": "True when this domain's saved values differ from the ones the running process started with."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status":                 { "type": "string", "example": "ok" },
          "time":                   { "type": "string", "format": "date-time" },
          "last_successful_replan": { "type": "string", "format": "date-time", "nullable": true },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id":      { "type": "string" },
                "last_synced_at": { "type": "string", "format": "date-time" },
                "webhook_id":     { "type": "string" },
                "webhook_expiry": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    }
  }
}
