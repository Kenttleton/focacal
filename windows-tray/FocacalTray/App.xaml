<Application
    x:Class="FocacalTray.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tray icon — lives for the full app lifetime -->
            <tb:TaskbarIcon
                x:Key="TrayIcon"
                ToolTipText="Focacal"
                IconSource="Assets/TrayIcon.ico">

                <!-- Right-click context menu -->
                <tb:TaskbarIcon.ContextMenuMode>SecondWindow</tb:TaskbarIcon.ContextMenuMode>
                <tb:TaskbarIcon.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="OpenFlyoutItem" Text="Open Focacal" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="SettingsItem"   Text="Settings"      />
                        <MenuFlyoutItem x:Name="OpenBrowserItem" Text="Open in browser" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="QuitItem"       Text="Quit"          />
                    </MenuFlyout>
                </tb:TaskbarIcon.ContextFlyout>
            </tb:TaskbarIcon>

        </ResourceDictionary>
    </Application.Resources>
</Application>
