<Window
    x:Class="FocacalTray.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FocacalTray">

    <!-- 320 × 480 floating panel, no title bar, always on top -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- header -->
            <RowDefinition Height="*" />       <!-- event list -->
            <RowDefinition Height="Auto" />   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,12,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Today"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <!-- Replan button -->
                <Button x:Name="ReplanButton"
                        Click="ReplanButton_Click"
                        Style="{ThemeResource DefaultButtonStyle}"
                        Width="32" Height="32" Padding="0"
                        ToolTipService.ToolTip="Re-run AI scheduler">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <!-- Open in browser -->
                <Button x:Name="BrowserButton"
                        Click="BrowserButton_Click"
                        Style="{ThemeResource DefaultButtonStyle}"
                        Width="32" Height="32" Padding="0"
                        ToolTipService.ToolTip="Open in browser">
                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                </Button>
                <!-- Settings -->
                <Button x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Style="{ThemeResource DefaultButtonStyle}"
                        Width="32" Height="32" Padding="0"
                        ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />

        <!-- Event list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="EventList" Padding="0,4,0,4" />
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="8" Visibility="Collapsed">
            <FontIcon Glyph="&#xE73E;" FontSize="28"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Nothing left today"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Error banner -->
        <InfoBar x:Name="ErrorBar" Grid.Row="1"
                 IsOpen="False" Severity="Warning"
                 Title="Cannot reach focacal"
                 IsClosable="False"
                 Margin="12,8" />

        <!-- Footer status -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                             Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="StatusText"
                               Text="Connected"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <ProgressRing x:Name="ReplanProgress"
                              IsActive="False" Width="16" Height="16"
                              HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>
